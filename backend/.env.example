# ===================================
# ENVIRONMENT CONFIGURATION
# ===================================
# Copy this file to .env and update with your actual values
# NEVER commit .env file to version control

# ===================================
# APPLICATION ENVIRONMENT
# ===================================
NODE_ENV=development
# Options: development, staging, production
# Controls logging level, error details, security strictness

# ===================================
# SERVER CONFIGURATION
# ===================================
PORT=5000
API_VERSION=v1
API_PREFIX=/api
HOST=localhost
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Server Timeout (in milliseconds)
SERVER_TIMEOUT=30000

# Trust Proxy (set to true if behind nginx/load balancer)
TRUST_PROXY=false

# ===================================
# DATABASE CONFIGURATION
# ===================================
# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/lms_database
MONGODB_TEST_URI=mongodb://localhost:27017/lms_test_database

# MongoDB Connection Pool Settings
MONGODB_POOL_SIZE=10
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5
MONGODB_SOCKET_TIMEOUT=45000
MONGODB_SERVER_SELECTION_TIMEOUT=5000

# Database Backup
DB_BACKUP_ENABLED=false
DB_BACKUP_SCHEDULE=0 2 * * *
# Cron format: minute hour day month weekday
DB_BACKUP_PATH=/backups/mongodb

# ===================================
# AUTHENTICATION & SECURITY
# ===================================
# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-change-in-production
JWT_EXPIRES_IN=15m
# Short-lived access tokens for security

JWT_REFRESH_SECRET=your-refresh-token-secret-minimum-32-characters-change-in-production
JWT_REFRESH_EXPIRES_IN=7d
# Longer-lived refresh tokens

# JWT Algorithm (HS256, HS384, HS512, RS256, etc.)
JWT_ALGORITHM=HS256

# Session Configuration
SESSION_SECRET=your-session-secret-minimum-32-characters-change-in-production
SESSION_NAME=lms.sid
SESSION_MAX_AGE=86400000
# 24 hours in milliseconds

# Cookie Settings
COOKIE_SECRET=your-cookie-secret-minimum-32-characters-change-in-production
COOKIE_SECURE=false
# Set to true in production (requires HTTPS)
COOKIE_SAME_SITE=lax
# Options: strict, lax, none
COOKIE_HTTP_ONLY=true
COOKIE_DOMAIN=localhost

# Password Security
BCRYPT_SALT_ROUNDS=12
# Higher = more secure but slower (10-12 recommended)

# Account Lockout
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900000
# 15 minutes in milliseconds

# Password Reset
PASSWORD_RESET_EXPIRES=3600000
# 1 hour in milliseconds

# Two-Factor Authentication (2FA)
ENABLE_2FA=false
TOTP_ISSUER=LMS Platform
TOTP_WINDOW=1

# ===================================
# CORS CONFIGURATION
# ===================================
CORS_ORIGIN=http://localhost:3000
# Comma-separated list: http://localhost:3000,https://yourdomain.com
CORS_CREDENTIALS=true
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_EXPOSED_HEADERS=Content-Range,X-Content-Range
CORS_MAX_AGE=86400

# ===================================
# RATE LIMITING
# ===================================
# Global Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
# 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_MESSAGE=Too many requests, please try again later

# Auth-specific Rate Limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# Password Reset Rate Limiting
PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=3600000
PASSWORD_RESET_RATE_LIMIT_MAX_REQUESTS=3

# File Upload Rate Limiting
UPLOAD_RATE_LIMIT_WINDOW_MS=3600000
UPLOAD_RATE_LIMIT_MAX_REQUESTS=50

# Payment Rate Limiting
PAYMENT_RATE_LIMIT_WINDOW_MS=3600000
PAYMENT_RATE_LIMIT_MAX_REQUESTS=10

# ===================================
# EMAIL CONFIGURATION
# ===================================
# Email Service Provider
EMAIL_SERVICE=gmail
# Options: gmail, outlook, yahoo, sendgrid, mailgun, ses, smtp

# SMTP Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
# Set to true for port 465, false for other ports
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password-here
# For Gmail: Enable 2FA and generate an App Password

# Email Sender Details
EMAIL_FROM=noreply@yourlms.com
EMAIL_FROM_NAME=LMS Platform

# Email Templates
EMAIL_TEMPLATE_DIR=src/templates/emails
EMAIL_VERIFICATION_EXPIRES=86400000
# 24 hours in milliseconds

# Email Queue (optional - for background processing)
EMAIL_QUEUE_ENABLED=false
EMAIL_QUEUE_CONCURRENCY=5

# ===================================
# FILE UPLOAD & STORAGE
# ===================================
# Upload Configuration
MAX_FILE_SIZE=10485760
# 10MB in bytes
MAX_VIDEO_SIZE=104857600
# 100MB in bytes
MAX_IMAGE_SIZE=5242880
# 5MB in bytes
MAX_DOCUMENT_SIZE=10485760
# 10MB in bytes

# Allowed File Types
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,ppt,pptx,mp4,mp3
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif,webp
ALLOWED_VIDEO_TYPES=mp4,mpeg,mov,avi,webm
ALLOWED_DOCUMENT_TYPES=pdf,doc,docx,ppt,pptx,xls,xlsx

# Storage Provider
STORAGE_PROVIDER=cloudinary
# Options: cloudinary, aws-s3, local

# Local Storage (if using local storage)
LOCAL_UPLOAD_DIR=uploads
LOCAL_UPLOAD_PATH=/var/www/lms/uploads

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=lms
CLOUDINARY_SECURE=true

# AWS S3 Configuration (if using S3)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-lms-bucket
AWS_S3_ACL=public-read

# ===================================
# PAYMENT GATEWAYS
# ===================================
# Stripe Configuration
STRIPE_ENABLED=false
STRIPE_PUBLIC_KEY=pk_test_your-publishable-key
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_CURRENCY=usd
STRIPE_SUCCESS_URL=http://localhost:3000/payment/success
STRIPE_CANCEL_URL=http://localhost:3000/payment/cancel

# PayPal Configuration
PAYPAL_ENABLED=false
PAYPAL_MODE=sandbox
# Options: sandbox, live
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_CURRENCY=USD
PAYPAL_RETURN_URL=http://localhost:3000/payment/success
PAYPAL_CANCEL_URL=http://localhost:3000/payment/cancel

# SSLCommerz Payment Gateway (Bangladesh)
SSLCOMMERZ_ENABLED=false
SSLCOMMERZ_STORE_ID=your-store-id
SSLCOMMERZ_STORE_PASSWORD=your-store-password
SSLCOMMERZ_MODE=sandbox
# Options: sandbox, live
SSLCOMMERZ_SUCCESS_URL=http://localhost:3000/payment/success
SSLCOMMERZ_FAIL_URL=http://localhost:3000/payment/fail
SSLCOMMERZ_CANCEL_URL=http://localhost:3000/payment/cancel
SSLCOMMERZ_IPN_URL=http://localhost:5000/api/v1/payment/ipn

# Payment Transaction Fee
PLATFORM_FEE_PERCENTAGE=10
# Platform commission percentage

# ===================================
# OAUTH & SOCIAL LOGIN
# ===================================
# Google OAuth
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Facebook OAuth
FACEBOOK_ENABLED=false
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/v1/auth/facebook/callback

# GitHub OAuth
GITHUB_ENABLED=false
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/auth/github/callback

# ===================================
# REDIS CONFIGURATION (Optional)
# ===================================
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379
# Full connection string (overrides individual settings)

# Redis for Sessions
REDIS_SESSION_PREFIX=sess:
REDIS_SESSION_TTL=86400
# 24 hours in seconds

# Redis for Caching
REDIS_CACHE_PREFIX=cache:
REDIS_CACHE_TTL=3600
# 1 hour in seconds

# ===================================
# LOGGING & MONITORING
# ===================================
# Logging Configuration
LOG_LEVEL=info
# Options: error, warn, info, http, verbose, debug, silly
LOG_FORMAT=json
# Options: json, simple, combined
LOG_DIR=logs
LOG_MAX_SIZE=10m
LOG_MAX_FILES=14d
# Keep logs for 14 days

# Console Logging
LOG_CONSOLE_ENABLED=true
LOG_CONSOLE_LEVEL=debug

# File Logging
LOG_FILE_ENABLED=true
LOG_ERROR_FILE=logs/error.log
LOG_COMBINED_FILE=logs/combined.log
LOG_ACCESS_FILE=logs/access.log

# Audit Logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_FILE=logs/audit.log
AUDIT_LOG_EVENTS=login,logout,create,update,delete,payment

# Error Tracking (Sentry, optional)
SENTRY_ENABLED=false
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# Performance Monitoring (New Relic, optional)
NEW_RELIC_ENABLED=false
NEW_RELIC_LICENSE_KEY=your-new-relic-license-key
NEW_RELIC_APP_NAME=LMS-Backend

# ===================================
# SECURITY HEADERS
# ===================================
# Content Security Policy
CSP_ENABLED=true
CSP_DIRECTIVES=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'

# HSTS (HTTP Strict Transport Security)
HSTS_ENABLED=false
# Set to true in production
HSTS_MAX_AGE=31536000
# 1 year in seconds
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false

# Security Headers
X_FRAME_OPTIONS=DENY
X_CONTENT_TYPE_OPTIONS=nosniff
X_XSS_PROTECTION=1; mode=block
REFERRER_POLICY=strict-origin-when-cross-origin

# ===================================
# IP CONTROL & FIREWALL
# ===================================
# IP Whitelist (comma-separated)
IP_WHITELIST=
# Example: 192.168.1.1,10.0.0.0/8

# IP Blacklist (comma-separated)
IP_BLACKLIST=
# Block specific IPs

# Enable IP-based rate limiting
IP_RATE_LIMITING=true

# ===================================
# CACHING
# ===================================
CACHE_ENABLED=true
CACHE_TTL=3600
# 1 hour in seconds
CACHE_PROVIDER=memory
# Options: memory, redis

# API Response Caching
API_CACHE_ENABLED=true
API_CACHE_TTL=300
# 5 minutes in seconds

# Static File Caching
STATIC_CACHE_MAX_AGE=86400
# 24 hours in seconds

# ===================================
# CERTIFICATE GENERATION
# ===================================
CERTIFICATE_ENABLED=true
CERTIFICATE_TEMPLATE_PATH=src/templates/certificates
CERTIFICATE_OUTPUT_DIR=certificates
CERTIFICATE_SIGNATURE_NAME=Dr. John Doe
CERTIFICATE_SIGNATURE_TITLE=CEO & Founder
CERTIFICATE_ORGANIZATION=LMS Platform

# ===================================
# VIDEO STREAMING
# ===================================
VIDEO_STREAMING_ENABLED=true
VIDEO_CHUNK_SIZE=1048576
# 1MB in bytes
VIDEO_QUALITY_OPTIONS=360p,480p,720p,1080p

# Video Processing (FFmpeg)
FFMPEG_ENABLED=false
FFMPEG_PATH=/usr/bin/ffmpeg
VIDEO_TRANSCODE_ENABLED=false

# ===================================
# SEARCH & INDEXING
# ===================================
# Elasticsearch (optional)
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=lms
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Algolia (optional)
ALGOLIA_ENABLED=false
ALGOLIA_APP_ID=your-algolia-app-id
ALGOLIA_ADMIN_KEY=your-algolia-admin-key
ALGOLIA_SEARCH_KEY=your-algolia-search-key
ALGOLIA_INDEX=courses

# ===================================
# NOTIFICATION SERVICES
# ===================================
# Push Notifications (Firebase Cloud Messaging)
FCM_ENABLED=false
FCM_SERVER_KEY=your-fcm-server-key
FCM_SENDER_ID=your-fcm-sender-id

# SMS Notifications (Twilio)
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Slack Notifications
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ===================================
# API DOCUMENTATION
# ===================================
SWAGGER_ENABLED=true
SWAGGER_TITLE=LMS API Documentation
SWAGGER_DESCRIPTION=Comprehensive API documentation for Learning Management System
SWAGGER_VERSION=1.0.0
SWAGGER_PATH=/api-docs
SWAGGER_AUTH_REQUIRED=false

# ===================================
# ANALYTICS & TRACKING
# ===================================
# Google Analytics
GOOGLE_ANALYTICS_ENABLED=false
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# Mixpanel
MIXPANEL_ENABLED=false
MIXPANEL_TOKEN=your-mixpanel-token

# ===================================
# DEVELOPMENT & TESTING
# ===================================
# Debug Mode
DEBUG=false
DEBUG_SQL=false
DEBUG_ROUTES=false

# Mock Data
USE_MOCK_DATA=false
SEED_DATABASE=false

# Testing
TEST_MODE=false
TEST_TIMEOUT=10000

# ===================================
# CRONJOBS & SCHEDULED TASKS
# ===================================
CRON_ENABLED=true

# Clean expired tokens (runs daily at 2 AM)
CRON_CLEAN_TOKENS=0 2 * * *

# Generate certificates (runs daily at 3 AM)
CRON_GENERATE_CERTIFICATES=0 3 * * *

# Send reminder emails (runs every 6 hours)
CRON_SEND_REMINDERS=0 */6 * * *

# Database backup (runs daily at 2 AM)
CRON_DB_BACKUP=0 2 * * *

# ===================================
# SSL/TLS CONFIGURATION
# ===================================
# SSL Certificate Paths (for HTTPS)
SSL_ENABLED=false
SSL_KEY_PATH=/path/to/private-key.pem
SSL_CERT_PATH=/path/to/certificate.pem
SSL_CA_PATH=/path/to/ca-bundle.pem

# ===================================
# ORGANIZATION SETTINGS
# ===================================
ORG_NAME=LMS Platform
ORG_LOGO_URL=https://yourdomain.com/logo.png
ORG_SUPPORT_EMAIL=support@yourlms.com
ORG_ADMIN_EMAIL=admin@yourlms.com
ORG_CONTACT_PHONE=+1234567890
ORG_ADDRESS=123 Main St, City, Country
ORG_WEBSITE=https://yourlms.com

# ===================================
# FEATURES FLAGS
# ===================================
FEATURE_CHAT_ENABLED=true
FEATURE_FORUM_ENABLED=true
FEATURE_LIVE_CLASSES_ENABLED=false
FEATURE_CERTIFICATES_ENABLED=true
FEATURE_ASSIGNMENTS_ENABLED=true
FEATURE_QUIZZES_ENABLED=true
FEATURE_GAMIFICATION_ENABLED=false
FEATURE_ANALYTICS_DASHBOARD=true

# ===================================
# TIMEZONE & LOCALIZATION
# ===================================
TIMEZONE=UTC
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,es,fr,de,ar,bn
DATE_FORMAT=YYYY-MM-DD
TIME_FORMAT=HH:mm:ss

# ===================================
# MAINTENANCE MODE
# ===================================
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=We are currently performing scheduled maintenance. Please check back soon.
MAINTENANCE_ALLOWED_IPS=
# Comma-separated IPs that can access during maintenance

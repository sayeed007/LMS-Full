# ===================================
# STAGING ENVIRONMENT
# ===================================
# This file contains staging-specific configuration
# Copy to .env and update with your actual staging values

# ===================================
# APPLICATION ENVIRONMENT
# ===================================
NODE_ENV=staging

# ===================================
# SERVER CONFIGURATION
# ===================================
PORT=5000
API_VERSION=v1
API_PREFIX=/api
HOST=0.0.0.0
BACKEND_URL=https://api-staging.yourlms.com
FRONTEND_URL=https://staging.yourlms.com
SERVER_TIMEOUT=30000
TRUST_PROXY=true

# ===================================
# DATABASE CONFIGURATION
# ===================================
MONGODB_URI=mongodb+srv://lms-user:PASSWORD@staging-cluster.mongodb.net/lms_staging?retryWrites=true&w=majority
MONGODB_TEST_URI=mongodb+srv://lms-user:PASSWORD@staging-cluster.mongodb.net/lms_staging_test?retryWrites=true&w=majority
MONGODB_POOL_SIZE=10
MONGODB_MAX_POOL_SIZE=30
MONGODB_MIN_POOL_SIZE=5
MONGODB_SOCKET_TIMEOUT=45000
MONGODB_SERVER_SELECTION_TIMEOUT=5000

# Database Backup
DB_BACKUP_ENABLED=true
DB_BACKUP_SCHEDULE=0 3 * * *
DB_BACKUP_PATH=/backups/mongodb

# ===================================
# AUTHENTICATION & SECURITY
# ===================================
JWT_SECRET=CHANGE-THIS-staging-jwt-secret-min-32-chars-RANDOM-STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE-THIS-staging-refresh-secret-min-32-chars-RANDOM-STRING
JWT_REFRESH_EXPIRES_IN=7d
JWT_ALGORITHM=HS256

SESSION_SECRET=CHANGE-THIS-staging-session-secret-min-32-chars-RANDOM-STRING
SESSION_NAME=lms.staging.sid
SESSION_MAX_AGE=86400000

COOKIE_SECRET=CHANGE-THIS-staging-cookie-secret-min-32-chars-RANDOM-STRING
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict
COOKIE_HTTP_ONLY=true
COOKIE_DOMAIN=.yourlms.com

BCRYPT_SALT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900000
PASSWORD_RESET_EXPIRES=3600000
ENABLE_2FA=false

# ===================================
# CORS CONFIGURATION
# ===================================
CORS_ORIGIN=https://staging.yourlms.com,https://www-staging.yourlms.com
CORS_CREDENTIALS=true
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_EXPOSED_HEADERS=Content-Range,X-Content-Range
CORS_MAX_AGE=86400

# ===================================
# RATE LIMITING
# ===================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=5
PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=3600000
PASSWORD_RESET_RATE_LIMIT_MAX_REQUESTS=3
UPLOAD_RATE_LIMIT_WINDOW_MS=3600000
UPLOAD_RATE_LIMIT_MAX_REQUESTS=50
PAYMENT_RATE_LIMIT_WINDOW_MS=3600000
PAYMENT_RATE_LIMIT_MAX_REQUESTS=10

# ===================================
# EMAIL CONFIGURATION
# ===================================
EMAIL_SERVICE=sendgrid
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USERNAME=apikey
EMAIL_PASSWORD=SG.your-sendgrid-api-key-here
EMAIL_FROM=noreply@staging.yourlms.com
EMAIL_FROM_NAME=LMS Platform (Staging)
EMAIL_TEMPLATE_DIR=src/templates/emails
EMAIL_VERIFICATION_EXPIRES=86400000
EMAIL_QUEUE_ENABLED=true
EMAIL_QUEUE_CONCURRENCY=5

# ===================================
# FILE UPLOAD & STORAGE
# ===================================
MAX_FILE_SIZE=10485760
MAX_VIDEO_SIZE=104857600
MAX_IMAGE_SIZE=5242880
MAX_DOCUMENT_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,ppt,pptx,mp4,mp3
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif,webp
ALLOWED_VIDEO_TYPES=mp4,mpeg,mov,avi,webm
ALLOWED_DOCUMENT_TYPES=pdf,doc,docx,ppt,pptx,xls,xlsx

# Use Cloudinary in staging
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=your-staging-cloud-name
CLOUDINARY_API_KEY=your-staging-api-key
CLOUDINARY_API_SECRET=your-staging-api-secret
CLOUDINARY_FOLDER=lms-staging
CLOUDINARY_SECURE=true

# ===================================
# PAYMENT GATEWAYS (Sandbox/Test mode)
# ===================================
STRIPE_ENABLED=true
STRIPE_PUBLIC_KEY=pk_test_your-staging-publishable-key
STRIPE_SECRET_KEY=sk_test_your-staging-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-staging-webhook-secret
STRIPE_CURRENCY=usd
STRIPE_SUCCESS_URL=https://staging.yourlms.com/payment/success
STRIPE_CANCEL_URL=https://staging.yourlms.com/payment/cancel

PAYPAL_ENABLED=true
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your-paypal-staging-client-id
PAYPAL_CLIENT_SECRET=your-paypal-staging-client-secret
PAYPAL_CURRENCY=USD
PAYPAL_RETURN_URL=https://staging.yourlms.com/payment/success
PAYPAL_CANCEL_URL=https://staging.yourlms.com/payment/cancel

SSLCOMMERZ_ENABLED=false
SSLCOMMERZ_MODE=sandbox

PLATFORM_FEE_PERCENTAGE=10

# ===================================
# OAUTH & SOCIAL LOGIN
# ===================================
GOOGLE_ENABLED=true
GOOGLE_CLIENT_ID=your-staging-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-staging-google-client-secret
GOOGLE_CALLBACK_URL=https://api-staging.yourlms.com/api/v1/auth/google/callback

FACEBOOK_ENABLED=false
FACEBOOK_APP_ID=your-staging-facebook-app-id
FACEBOOK_APP_SECRET=your-staging-facebook-app-secret
FACEBOOK_CALLBACK_URL=https://api-staging.yourlms.com/api/v1/auth/facebook/callback

GITHUB_ENABLED=false

# ===================================
# REDIS CONFIGURATION
# ===================================
REDIS_ENABLED=true
REDIS_HOST=redis-staging.yourdomain.com
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-staging-password
REDIS_DB=0
REDIS_URL=redis://:your-redis-staging-password@redis-staging.yourdomain.com:6379
REDIS_SESSION_PREFIX=sess:
REDIS_SESSION_TTL=86400
REDIS_CACHE_PREFIX=cache:
REDIS_CACHE_TTL=3600

# ===================================
# LOGGING & MONITORING
# ===================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_DIR=logs
LOG_MAX_SIZE=10m
LOG_MAX_FILES=14d
LOG_CONSOLE_ENABLED=true
LOG_CONSOLE_LEVEL=info
LOG_FILE_ENABLED=true
LOG_ERROR_FILE=logs/error.log
LOG_COMBINED_FILE=logs/combined.log
LOG_ACCESS_FILE=logs/access.log
AUDIT_LOG_ENABLED=true
AUDIT_LOG_FILE=logs/audit.log
AUDIT_LOG_EVENTS=login,logout,create,update,delete,payment

# Error Tracking
SENTRY_ENABLED=true
SENTRY_DSN=https://your-sentry-dsn@sentry.io/staging-project-id
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0.5

# Performance Monitoring
NEW_RELIC_ENABLED=false

# ===================================
# SECURITY HEADERS
# ===================================
CSP_ENABLED=true
CSP_DIRECTIVES=default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api-staging.yourlms.com

HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false

X_FRAME_OPTIONS=DENY
X_CONTENT_TYPE_OPTIONS=nosniff
X_XSS_PROTECTION=1; mode=block
REFERRER_POLICY=strict-origin-when-cross-origin

# ===================================
# IP CONTROL
# ===================================
IP_WHITELIST=
IP_BLACKLIST=
IP_RATE_LIMITING=true

# ===================================
# CACHING
# ===================================
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_PROVIDER=redis
API_CACHE_ENABLED=true
API_CACHE_TTL=300
STATIC_CACHE_MAX_AGE=86400

# ===================================
# CERTIFICATE GENERATION
# ===================================
CERTIFICATE_ENABLED=true
CERTIFICATE_TEMPLATE_PATH=src/templates/certificates
CERTIFICATE_OUTPUT_DIR=certificates
CERTIFICATE_SIGNATURE_NAME=Dr. Jane Smith
CERTIFICATE_SIGNATURE_TITLE=Director of Education
CERTIFICATE_ORGANIZATION=LMS Platform (Staging)

# ===================================
# VIDEO STREAMING
# ===================================
VIDEO_STREAMING_ENABLED=true
VIDEO_CHUNK_SIZE=1048576
VIDEO_QUALITY_OPTIONS=360p,480p,720p,1080p
FFMPEG_ENABLED=false
VIDEO_TRANSCODE_ENABLED=false

# ===================================
# SEARCH & INDEXING
# ===================================
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_NODE=https://staging-es.yourdomain.com:9200
ELASTICSEARCH_INDEX=lms-staging
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your-es-staging-password

ALGOLIA_ENABLED=false

# ===================================
# NOTIFICATION SERVICES
# ===================================
FCM_ENABLED=false
TWILIO_ENABLED=false
SLACK_ENABLED=true
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/STAGING/WEBHOOK

# ===================================
# API DOCUMENTATION
# ===================================
SWAGGER_ENABLED=true
SWAGGER_TITLE=LMS API Documentation (Staging)
SWAGGER_DESCRIPTION=Staging API documentation for testing
SWAGGER_VERSION=1.0.0
SWAGGER_PATH=/api-docs
SWAGGER_AUTH_REQUIRED=true

# ===================================
# ANALYTICS & TRACKING
# ===================================
GOOGLE_ANALYTICS_ENABLED=false
MIXPANEL_ENABLED=false

# ===================================
# DEVELOPMENT & TESTING
# ===================================
DEBUG=false
DEBUG_SQL=false
DEBUG_ROUTES=false
USE_MOCK_DATA=false
SEED_DATABASE=false
TEST_MODE=false

# ===================================
# CRONJOBS & SCHEDULED TASKS
# ===================================
CRON_ENABLED=true
CRON_CLEAN_TOKENS=0 2 * * *
CRON_GENERATE_CERTIFICATES=0 3 * * *
CRON_SEND_REMINDERS=0 */6 * * *
CRON_DB_BACKUP=0 3 * * *

# ===================================
# SSL/TLS CONFIGURATION
# ===================================
SSL_ENABLED=false
# SSL handled by reverse proxy (nginx/load balancer)

# ===================================
# ORGANIZATION SETTINGS
# ===================================
ORG_NAME=LMS Platform (Staging)
ORG_LOGO_URL=https://staging.yourlms.com/logo.png
ORG_SUPPORT_EMAIL=support-staging@yourlms.com
ORG_ADMIN_EMAIL=admin-staging@yourlms.com
ORG_CONTACT_PHONE=+1234567890
ORG_ADDRESS=123 Main St, City, Country
ORG_WEBSITE=https://staging.yourlms.com

# ===================================
# FEATURES FLAGS
# ===================================
FEATURE_CHAT_ENABLED=true
FEATURE_FORUM_ENABLED=true
FEATURE_LIVE_CLASSES_ENABLED=false
FEATURE_CERTIFICATES_ENABLED=true
FEATURE_ASSIGNMENTS_ENABLED=true
FEATURE_QUIZZES_ENABLED=true
FEATURE_GAMIFICATION_ENABLED=false
FEATURE_ANALYTICS_DASHBOARD=true

# ===================================
# TIMEZONE & LOCALIZATION
# ===================================
TIMEZONE=UTC
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,es,fr,de,ar,bn
DATE_FORMAT=YYYY-MM-DD
TIME_FORMAT=HH:mm:ss

# ===================================
# MAINTENANCE MODE
# ===================================
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=Staging environment is temporarily unavailable. Please try again later.
MAINTENANCE_ALLOWED_IPS=203.0.113.0,203.0.113.1

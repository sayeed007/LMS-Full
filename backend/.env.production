# ===================================
# PRODUCTION ENVIRONMENT
# ===================================
# This file contains production-specific configuration
# Copy to .env and update with your actual production values
# IMPORTANT: Use strong, randomly generated secrets in production

# ===================================
# APPLICATION ENVIRONMENT
# ===================================
NODE_ENV=production

# ===================================
# SERVER CONFIGURATION
# ===================================
PORT=5000
API_VERSION=v1
API_PREFIX=/api
HOST=0.0.0.0
BACKEND_URL=https://api.yourlms.com
FRONTEND_URL=https://www.yourlms.com
SERVER_TIMEOUT=30000
TRUST_PROXY=true

# ===================================
# DATABASE CONFIGURATION
# ===================================
MONGODB_URI=mongodb+srv://lms-prod-user:STRONG-PASSWORD@production-cluster.mongodb.net/lms_production?retryWrites=true&w=majority&readPreference=primaryPreferred
MONGODB_TEST_URI=mongodb+srv://lms-prod-user:STRONG-PASSWORD@production-cluster.mongodb.net/lms_test?retryWrites=true&w=majority
MONGODB_POOL_SIZE=20
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10
MONGODB_SOCKET_TIMEOUT=45000
MONGODB_SERVER_SELECTION_TIMEOUT=5000

# Database Backup
DB_BACKUP_ENABLED=true
DB_BACKUP_SCHEDULE=0 2 * * *
DB_BACKUP_PATH=/backups/mongodb

# ===================================
# AUTHENTICATION & SECURITY
# ===================================
# CRITICAL: Generate strong random secrets (minimum 32 characters)
# Use: openssl rand -base64 32
JWT_SECRET=CHANGE-THIS-TO-STRONG-RANDOM-STRING-MIN-64-CHARS-FOR-PRODUCTION
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE-THIS-TO-DIFFERENT-STRONG-RANDOM-STRING-MIN-64-CHARS
JWT_REFRESH_EXPIRES_IN=7d
JWT_ALGORITHM=HS256

SESSION_SECRET=CHANGE-THIS-TO-STRONG-RANDOM-STRING-MIN-64-CHARS-FOR-SESSIONS
SESSION_NAME=lms.sid
SESSION_MAX_AGE=86400000

COOKIE_SECRET=CHANGE-THIS-TO-STRONG-RANDOM-STRING-MIN-64-CHARS-FOR-COOKIES
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict
COOKIE_HTTP_ONLY=true
COOKIE_DOMAIN=.yourlms.com

BCRYPT_SALT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900000
PASSWORD_RESET_EXPIRES=3600000
ENABLE_2FA=true
TOTP_ISSUER=LMS Platform
TOTP_WINDOW=1

# ===================================
# CORS CONFIGURATION
# ===================================
CORS_ORIGIN=https://www.yourlms.com,https://yourlms.com,https://app.yourlms.com
CORS_CREDENTIALS=true
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_EXPOSED_HEADERS=Content-Range,X-Content-Range
CORS_MAX_AGE=86400

# ===================================
# RATE LIMITING
# ===================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_MESSAGE=Too many requests. Please try again later.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=5
PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=3600000
PASSWORD_RESET_RATE_LIMIT_MAX_REQUESTS=3
UPLOAD_RATE_LIMIT_WINDOW_MS=3600000
UPLOAD_RATE_LIMIT_MAX_REQUESTS=50
PAYMENT_RATE_LIMIT_WINDOW_MS=3600000
PAYMENT_RATE_LIMIT_MAX_REQUESTS=10

# ===================================
# EMAIL CONFIGURATION
# ===================================
# Production email service (SendGrid, Mailgun, AWS SES, etc.)
EMAIL_SERVICE=sendgrid
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USERNAME=apikey
EMAIL_PASSWORD=SG.YOUR-PRODUCTION-SENDGRID-API-KEY
EMAIL_FROM=noreply@yourlms.com
EMAIL_FROM_NAME=LMS Platform
EMAIL_TEMPLATE_DIR=src/templates/emails
EMAIL_VERIFICATION_EXPIRES=86400000
EMAIL_QUEUE_ENABLED=true
EMAIL_QUEUE_CONCURRENCY=10

# ===================================
# FILE UPLOAD & STORAGE
# ===================================
MAX_FILE_SIZE=10485760
MAX_VIDEO_SIZE=104857600
MAX_IMAGE_SIZE=5242880
MAX_DOCUMENT_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,ppt,pptx,mp4,mp3
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif,webp
ALLOWED_VIDEO_TYPES=mp4,mpeg,mov,avi,webm
ALLOWED_DOCUMENT_TYPES=pdf,doc,docx,ppt,pptx,xls,xlsx

# Production storage (Cloudinary or AWS S3)
STORAGE_PROVIDER=cloudinary

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-production-cloud-name
CLOUDINARY_API_KEY=your-production-api-key
CLOUDINARY_API_SECRET=your-production-api-secret
CLOUDINARY_FOLDER=lms-production
CLOUDINARY_SECURE=true

# AWS S3 Configuration (alternative)
AWS_ACCESS_KEY_ID=your-production-aws-access-key
AWS_SECRET_ACCESS_KEY=your-production-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=yourlms-production
AWS_S3_ACL=public-read

# ===================================
# PAYMENT GATEWAYS (LIVE MODE)
# ===================================
STRIPE_ENABLED=true
STRIPE_PUBLIC_KEY=pk_live_YOUR-PRODUCTION-PUBLISHABLE-KEY
STRIPE_SECRET_KEY=sk_live_YOUR-PRODUCTION-SECRET-KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR-PRODUCTION-WEBHOOK-SECRET
STRIPE_CURRENCY=usd
STRIPE_SUCCESS_URL=https://www.yourlms.com/payment/success
STRIPE_CANCEL_URL=https://www.yourlms.com/payment/cancel

PAYPAL_ENABLED=true
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=YOUR-PRODUCTION-PAYPAL-CLIENT-ID
PAYPAL_CLIENT_SECRET=YOUR-PRODUCTION-PAYPAL-CLIENT-SECRET
PAYPAL_CURRENCY=USD
PAYPAL_RETURN_URL=https://www.yourlms.com/payment/success
PAYPAL_CANCEL_URL=https://www.yourlms.com/payment/cancel

SSLCOMMERZ_ENABLED=false
SSLCOMMERZ_STORE_ID=your-production-store-id
SSLCOMMERZ_STORE_PASSWORD=your-production-store-password
SSLCOMMERZ_MODE=live
SSLCOMMERZ_SUCCESS_URL=https://www.yourlms.com/payment/success
SSLCOMMERZ_FAIL_URL=https://www.yourlms.com/payment/fail
SSLCOMMERZ_CANCEL_URL=https://www.yourlms.com/payment/cancel
SSLCOMMERZ_IPN_URL=https://api.yourlms.com/api/v1/payment/ipn

PLATFORM_FEE_PERCENTAGE=10

# ===================================
# OAUTH & SOCIAL LOGIN
# ===================================
GOOGLE_ENABLED=true
GOOGLE_CLIENT_ID=YOUR-PRODUCTION-GOOGLE-CLIENT-ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR-PRODUCTION-GOOGLE-CLIENT-SECRET
GOOGLE_CALLBACK_URL=https://api.yourlms.com/api/v1/auth/google/callback

FACEBOOK_ENABLED=true
FACEBOOK_APP_ID=YOUR-PRODUCTION-FACEBOOK-APP-ID
FACEBOOK_APP_SECRET=YOUR-PRODUCTION-FACEBOOK-APP-SECRET
FACEBOOK_CALLBACK_URL=https://api.yourlms.com/api/v1/auth/facebook/callback

GITHUB_ENABLED=false
GITHUB_CLIENT_ID=YOUR-PRODUCTION-GITHUB-CLIENT-ID
GITHUB_CLIENT_SECRET=YOUR-PRODUCTION-GITHUB-CLIENT-SECRET
GITHUB_CALLBACK_URL=https://api.yourlms.com/api/v1/auth/github/callback

# ===================================
# REDIS CONFIGURATION
# ===================================
REDIS_ENABLED=true
REDIS_HOST=redis.yourdomain.com
REDIS_PORT=6379
REDIS_PASSWORD=STRONG-REDIS-PASSWORD
REDIS_DB=0
REDIS_URL=redis://:STRONG-REDIS-PASSWORD@redis.yourdomain.com:6379
REDIS_SESSION_PREFIX=sess:
REDIS_SESSION_TTL=86400
REDIS_CACHE_PREFIX=cache:
REDIS_CACHE_TTL=3600

# ===================================
# LOGGING & MONITORING
# ===================================
LOG_LEVEL=warn
LOG_FORMAT=json
LOG_DIR=/var/log/lms
LOG_MAX_SIZE=20m
LOG_MAX_FILES=30d
LOG_CONSOLE_ENABLED=false
LOG_CONSOLE_LEVEL=error
LOG_FILE_ENABLED=true
LOG_ERROR_FILE=/var/log/lms/error.log
LOG_COMBINED_FILE=/var/log/lms/combined.log
LOG_ACCESS_FILE=/var/log/lms/access.log
AUDIT_LOG_ENABLED=true
AUDIT_LOG_FILE=/var/log/lms/audit.log
AUDIT_LOG_EVENTS=login,logout,create,update,delete,payment,admin_action

# Error Tracking (Sentry)
SENTRY_ENABLED=true
SENTRY_DSN=https://YOUR-PRODUCTION-SENTRY-DSN@sentry.io/production-project-id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Performance Monitoring (New Relic)
NEW_RELIC_ENABLED=true
NEW_RELIC_LICENSE_KEY=YOUR-PRODUCTION-NEW-RELIC-LICENSE-KEY
NEW_RELIC_APP_NAME=LMS-Production

# ===================================
# SECURITY HEADERS
# ===================================
CSP_ENABLED=true
CSP_DIRECTIVES=default-src 'self'; script-src 'self' https://cdn.jsdelivr.net https://js.stripe.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api.yourlms.com; frame-src https://js.stripe.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

X_FRAME_OPTIONS=DENY
X_CONTENT_TYPE_OPTIONS=nosniff
X_XSS_PROTECTION=1; mode=block
REFERRER_POLICY=strict-origin-when-cross-origin

# ===================================
# IP CONTROL & FIREWALL
# ===================================
# Whitelist for admin access (optional)
IP_WHITELIST=
# Block known malicious IPs
IP_BLACKLIST=
IP_RATE_LIMITING=true

# ===================================
# CACHING
# ===================================
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_PROVIDER=redis
API_CACHE_ENABLED=true
API_CACHE_TTL=300
STATIC_CACHE_MAX_AGE=31536000

# ===================================
# CERTIFICATE GENERATION
# ===================================
CERTIFICATE_ENABLED=true
CERTIFICATE_TEMPLATE_PATH=src/templates/certificates
CERTIFICATE_OUTPUT_DIR=/var/lms/certificates
CERTIFICATE_SIGNATURE_NAME=Dr. John Smith
CERTIFICATE_SIGNATURE_TITLE=CEO & Founder
CERTIFICATE_ORGANIZATION=LMS Platform

# ===================================
# VIDEO STREAMING
# ===================================
VIDEO_STREAMING_ENABLED=true
VIDEO_CHUNK_SIZE=1048576
VIDEO_QUALITY_OPTIONS=360p,480p,720p,1080p
FFMPEG_ENABLED=true
FFMPEG_PATH=/usr/bin/ffmpeg
VIDEO_TRANSCODE_ENABLED=true

# ===================================
# SEARCH & INDEXING
# ===================================
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_NODE=https://production-es.yourdomain.com:9200
ELASTICSEARCH_INDEX=lms-courses
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=STRONG-ELASTICSEARCH-PASSWORD

ALGOLIA_ENABLED=false
ALGOLIA_APP_ID=YOUR-ALGOLIA-APP-ID
ALGOLIA_ADMIN_KEY=YOUR-ALGOLIA-ADMIN-KEY
ALGOLIA_SEARCH_KEY=YOUR-ALGOLIA-SEARCH-KEY
ALGOLIA_INDEX=courses

# ===================================
# NOTIFICATION SERVICES
# ===================================
FCM_ENABLED=true
FCM_SERVER_KEY=YOUR-PRODUCTION-FCM-SERVER-KEY
FCM_SENDER_ID=YOUR-PRODUCTION-FCM-SENDER-ID

TWILIO_ENABLED=true
TWILIO_ACCOUNT_SID=YOUR-PRODUCTION-TWILIO-ACCOUNT-SID
TWILIO_AUTH_TOKEN=YOUR-PRODUCTION-TWILIO-AUTH-TOKEN
TWILIO_PHONE_NUMBER=+1234567890

SLACK_ENABLED=true
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/PRODUCTION/WEBHOOK

# ===================================
# API DOCUMENTATION
# ===================================
# Disable or protect Swagger in production
SWAGGER_ENABLED=false
SWAGGER_TITLE=LMS API Documentation
SWAGGER_DESCRIPTION=Production API documentation
SWAGGER_VERSION=1.0.0
SWAGGER_PATH=/api-docs
SWAGGER_AUTH_REQUIRED=true

# ===================================
# ANALYTICS & TRACKING
# ===================================
GOOGLE_ANALYTICS_ENABLED=true
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

MIXPANEL_ENABLED=true
MIXPANEL_TOKEN=YOUR-PRODUCTION-MIXPANEL-TOKEN

# ===================================
# DEVELOPMENT & TESTING
# ===================================
DEBUG=false
DEBUG_SQL=false
DEBUG_ROUTES=false
USE_MOCK_DATA=false
SEED_DATABASE=false
TEST_MODE=false

# ===================================
# CRONJOBS & SCHEDULED TASKS
# ===================================
CRON_ENABLED=true
CRON_CLEAN_TOKENS=0 2 * * *
CRON_GENERATE_CERTIFICATES=0 3 * * *
CRON_SEND_REMINDERS=0 8,14,20 * * *
CRON_DB_BACKUP=0 2 * * *

# ===================================
# SSL/TLS CONFIGURATION
# ===================================
SSL_ENABLED=false
# SSL handled by reverse proxy (nginx, cloudflare, load balancer)
# If handling SSL directly:
SSL_KEY_PATH=/etc/ssl/private/yourlms.key
SSL_CERT_PATH=/etc/ssl/certs/yourlms.crt
SSL_CA_PATH=/etc/ssl/certs/ca-bundle.crt

# ===================================
# ORGANIZATION SETTINGS
# ===================================
ORG_NAME=LMS Platform
ORG_LOGO_URL=https://www.yourlms.com/assets/logo.png
ORG_SUPPORT_EMAIL=support@yourlms.com
ORG_ADMIN_EMAIL=admin@yourlms.com
ORG_CONTACT_PHONE=+1-800-LMS-HELP
ORG_ADDRESS=123 Education Street, Learning City, ED 12345, USA
ORG_WEBSITE=https://www.yourlms.com

# ===================================
# FEATURES FLAGS
# ===================================
FEATURE_CHAT_ENABLED=true
FEATURE_FORUM_ENABLED=true
FEATURE_LIVE_CLASSES_ENABLED=true
FEATURE_CERTIFICATES_ENABLED=true
FEATURE_ASSIGNMENTS_ENABLED=true
FEATURE_QUIZZES_ENABLED=true
FEATURE_GAMIFICATION_ENABLED=true
FEATURE_ANALYTICS_DASHBOARD=true

# ===================================
# TIMEZONE & LOCALIZATION
# ===================================
TIMEZONE=UTC
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,es,fr,de,ar,bn,hi,zh,ja,ko
DATE_FORMAT=YYYY-MM-DD
TIME_FORMAT=HH:mm:ss

# ===================================
# MAINTENANCE MODE
# ===================================
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=We are currently performing scheduled maintenance. We'll be back shortly. Thank you for your patience.
MAINTENANCE_ALLOWED_IPS=203.0.113.100,203.0.113.101
# Admin/DevOps team IPs who can access during maintenance

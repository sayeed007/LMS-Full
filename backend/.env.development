# ===================================
# DEVELOPMENT ENVIRONMENT
# ===================================
# This file contains development-specific configuration
# Copy to .env and customize for your local development environment

# ===================================
# APPLICATION ENVIRONMENT
# ===================================
NODE_ENV=development

# ===================================
# SERVER CONFIGURATION
# ===================================
PORT=5000
API_VERSION=v1
API_PREFIX=/api
HOST=localhost
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
SERVER_TIMEOUT=30000
TRUST_PROXY=false

# ===================================
# DATABASE CONFIGURATION
# ===================================
MONGODB_URI=mongodb://localhost:27017/lms_development
MONGODB_TEST_URI=mongodb://localhost:27017/lms_test
MONGODB_POOL_SIZE=5
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=2
MONGODB_SOCKET_TIMEOUT=45000
MONGODB_SERVER_SELECTION_TIMEOUT=5000

# Database Backup (disabled in development)
DB_BACKUP_ENABLED=false

# ===================================
# AUTHENTICATION & SECURITY
# ===================================
JWT_SECRET=dev-jwt-secret-minimum-32-characters-for-development-only
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=dev-refresh-secret-minimum-32-characters-for-development
JWT_REFRESH_EXPIRES_IN=30d
JWT_ALGORITHM=HS256

SESSION_SECRET=dev-session-secret-minimum-32-characters-for-development
SESSION_NAME=lms.dev.sid
SESSION_MAX_AGE=86400000

COOKIE_SECRET=dev-cookie-secret-minimum-32-characters-for-development
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_HTTP_ONLY=true
COOKIE_DOMAIN=localhost

BCRYPT_SALT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=10
LOCKOUT_DURATION=300000
PASSWORD_RESET_EXPIRES=3600000
ENABLE_2FA=false

# ===================================
# CORS CONFIGURATION
# ===================================
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_EXPOSED_HEADERS=Content-Range,X-Content-Range
CORS_MAX_AGE=86400

# ===================================
# RATE LIMITING (Relaxed for development)
# ===================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=100
PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=3600000
PASSWORD_RESET_RATE_LIMIT_MAX_REQUESTS=10
UPLOAD_RATE_LIMIT_WINDOW_MS=3600000
UPLOAD_RATE_LIMIT_MAX_REQUESTS=100
PAYMENT_RATE_LIMIT_WINDOW_MS=3600000
PAYMENT_RATE_LIMIT_MAX_REQUESTS=50

# ===================================
# EMAIL CONFIGURATION (Local testing)
# ===================================
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USERNAME=your-dev-email@gmail.com
EMAIL_PASSWORD=your-dev-app-password
EMAIL_FROM=dev@lms-local.com
EMAIL_FROM_NAME=LMS Dev
EMAIL_TEMPLATE_DIR=src/templates/emails
EMAIL_VERIFICATION_EXPIRES=86400000
EMAIL_QUEUE_ENABLED=false

# ===================================
# FILE UPLOAD & STORAGE
# ===================================
MAX_FILE_SIZE=10485760
MAX_VIDEO_SIZE=104857600
MAX_IMAGE_SIZE=5242880
MAX_DOCUMENT_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,ppt,pptx,mp4,mp3
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif,webp
ALLOWED_VIDEO_TYPES=mp4,mpeg,mov,avi,webm
ALLOWED_DOCUMENT_TYPES=pdf,doc,docx,ppt,pptx,xls,xlsx

# Use local storage in development
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=uploads
LOCAL_UPLOAD_PATH=./uploads

# Cloudinary (for testing cloud storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=lms-dev
CLOUDINARY_SECURE=false

# ===================================
# PAYMENT GATEWAYS (Test/Sandbox mode)
# ===================================
STRIPE_ENABLED=false
STRIPE_PUBLIC_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
STRIPE_SUCCESS_URL=http://localhost:3000/payment/success
STRIPE_CANCEL_URL=http://localhost:3000/payment/cancel

PAYPAL_ENABLED=false
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CURRENCY=USD

SSLCOMMERZ_ENABLED=false
SSLCOMMERZ_MODE=sandbox

PLATFORM_FEE_PERCENTAGE=10

# ===================================
# OAUTH & SOCIAL LOGIN
# ===================================
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

FACEBOOK_ENABLED=false
GITHUB_ENABLED=false

# ===================================
# REDIS CONFIGURATION
# ===================================
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379

# ===================================
# LOGGING & MONITORING
# ===================================
LOG_LEVEL=debug
LOG_FORMAT=simple
LOG_DIR=logs
LOG_MAX_SIZE=10m
LOG_MAX_FILES=7d
LOG_CONSOLE_ENABLED=true
LOG_CONSOLE_LEVEL=debug
LOG_FILE_ENABLED=false
AUDIT_LOG_ENABLED=false

# Monitoring disabled in development
SENTRY_ENABLED=false
NEW_RELIC_ENABLED=false

# ===================================
# SECURITY HEADERS (Relaxed)
# ===================================
CSP_ENABLED=false
HSTS_ENABLED=false
X_FRAME_OPTIONS=SAMEORIGIN
X_CONTENT_TYPE_OPTIONS=nosniff
X_XSS_PROTECTION=1; mode=block
REFERRER_POLICY=no-referrer-when-downgrade

# ===================================
# IP CONTROL
# ===================================
IP_WHITELIST=
IP_BLACKLIST=
IP_RATE_LIMITING=false

# ===================================
# CACHING
# ===================================
CACHE_ENABLED=false
CACHE_TTL=300
CACHE_PROVIDER=memory
API_CACHE_ENABLED=false
STATIC_CACHE_MAX_AGE=0

# ===================================
# CERTIFICATE GENERATION
# ===================================
CERTIFICATE_ENABLED=true
CERTIFICATE_TEMPLATE_PATH=src/templates/certificates
CERTIFICATE_OUTPUT_DIR=certificates
CERTIFICATE_SIGNATURE_NAME=John Doe
CERTIFICATE_SIGNATURE_TITLE=Development Lead
CERTIFICATE_ORGANIZATION=LMS Dev Platform

# ===================================
# VIDEO STREAMING
# ===================================
VIDEO_STREAMING_ENABLED=true
VIDEO_CHUNK_SIZE=1048576
VIDEO_QUALITY_OPTIONS=360p,480p,720p
FFMPEG_ENABLED=false
VIDEO_TRANSCODE_ENABLED=false

# ===================================
# SEARCH & INDEXING
# ===================================
ELASTICSEARCH_ENABLED=false
ALGOLIA_ENABLED=false

# ===================================
# NOTIFICATION SERVICES
# ===================================
FCM_ENABLED=false
TWILIO_ENABLED=false
SLACK_ENABLED=false

# ===================================
# API DOCUMENTATION
# ===================================
SWAGGER_ENABLED=true
SWAGGER_TITLE=LMS API Documentation (Dev)
SWAGGER_DESCRIPTION=Development API documentation
SWAGGER_VERSION=1.0.0
SWAGGER_PATH=/api-docs
SWAGGER_AUTH_REQUIRED=false

# ===================================
# ANALYTICS & TRACKING
# ===================================
GOOGLE_ANALYTICS_ENABLED=false
MIXPANEL_ENABLED=false

# ===================================
# DEVELOPMENT & TESTING
# ===================================
DEBUG=true
DEBUG_SQL=false
DEBUG_ROUTES=true
USE_MOCK_DATA=false
SEED_DATABASE=false
TEST_MODE=false
TEST_TIMEOUT=10000

# ===================================
# CRONJOBS & SCHEDULED TASKS
# ===================================
CRON_ENABLED=false

# ===================================
# SSL/TLS CONFIGURATION
# ===================================
SSL_ENABLED=false

# ===================================
# ORGANIZATION SETTINGS
# ===================================
ORG_NAME=LMS Development Platform
ORG_LOGO_URL=http://localhost:3000/logo.png
ORG_SUPPORT_EMAIL=dev-support@lms-local.com
ORG_ADMIN_EMAIL=dev-admin@lms-local.com
ORG_WEBSITE=http://localhost:3000

# ===================================
# FEATURES FLAGS
# ===================================
FEATURE_CHAT_ENABLED=true
FEATURE_FORUM_ENABLED=true
FEATURE_LIVE_CLASSES_ENABLED=true
FEATURE_CERTIFICATES_ENABLED=true
FEATURE_ASSIGNMENTS_ENABLED=true
FEATURE_QUIZZES_ENABLED=true
FEATURE_GAMIFICATION_ENABLED=true
FEATURE_ANALYTICS_DASHBOARD=true

# ===================================
# TIMEZONE & LOCALIZATION
# ===================================
TIMEZONE=UTC
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,es,fr
DATE_FORMAT=YYYY-MM-DD
TIME_FORMAT=HH:mm:ss

# ===================================
# MAINTENANCE MODE
# ===================================
MAINTENANCE_MODE=false

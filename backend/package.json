{
  "name": "lms-backend",
  "version": "1.0.0",
  "description": "Backend for Learning Management System",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "validate:env": "node scripts/validate-env.js",
    "db:init": "node scripts/init-database.js",
    "db:indexes": "node scripts/init-database.js --create-indexes",
    "db:validate": "node scripts/init-database.js --validate",
    "db:backup": "node scripts/backup-database.js",
    "db:backup:compress": "node scripts/backup-database.js --compress",
    "db:restore": "node scripts/restore-database.js",
    "db:restore:latest": "node scripts/restore-database.js --latest",
    "db:list-backups": "node scripts/restore-database.js --list",
    "seedArticle": "node src/scripts/seedArticles.js",
    "seed": "node src/scripts/seedAll.js",
    "seed:clear": "node src/scripts/seedAll.js --clear",
    "seed:help": "node src/scripts/seedAll.js --help",
    "db:reset": "npm run seed:clear && npm run seed"
  },
  "keywords": [
    "lms",
    "education",
    "mongodb",
    "express",
    "nodejs"
  ],
  "author": "Your Name",
  "license": "ISC",
  "dependencies": {
    "@sentry/node": "^10.26.0",
    "@sentry/profiling-node": "^10.26.0",
    "bcryptjs": "^2.4.3",
    "chalk": "^4.1.2",
    "cloudinary": "^2.7.0",
    "connect-mongo": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "express-validator": "^7.3.1",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.15",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdfkit": "^0.17.2",
    "rate-limit-mongo": "^2.3.2",
    "socket.io": "^4.8.1",
    "sslcommerz-lts": "^1.2.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0"
  }
}

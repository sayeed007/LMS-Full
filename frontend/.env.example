# ===================================
# FRONTEND ENVIRONMENT CONFIGURATION
# ===================================
# Copy this file to .env.local and update with your actual values
# NEVER commit .env.local to version control

# ===================================
# IMPORTANT NOTES FOR NEXT.JS
# ===================================
# - Variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# - Other variables are only available on the server-side
# - Changes to .env files require restarting the dev server

# ===================================
# APPLICATION ENVIRONMENT
# ===================================
NODE_ENV=development
# Options: development, staging, production

# ===================================
# API CONFIGURATION
# ===================================
# Backend API URL (exposed to browser)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_API_TIMEOUT=30000

# Internal API URL (server-side only, for SSR)
API_URL=http://localhost:5000/api/v1

# ===================================
# NEXTAUTH.JS CONFIGURATION
# ===================================
# NextAuth URL (your frontend URL)
NEXTAUTH_URL=http://localhost:3000

# NextAuth Secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your-secret-key-minimum-32-characters-change-in-production

# Session settings
NEXTAUTH_SESSION_MAX_AGE=86400
# 24 hours in seconds

# ===================================
# OAUTH PROVIDERS
# ===================================
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Facebook OAuth
FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ===================================
# PUBLIC APPLICATION SETTINGS
# ===================================
# Application Name
NEXT_PUBLIC_APP_NAME=LMS Platform

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Organization Details
NEXT_PUBLIC_ORG_NAME=LMS Platform
NEXT_PUBLIC_ORG_LOGO_URL=https://yourlms.com/logo.png
NEXT_PUBLIC_ORG_SUPPORT_EMAIL=support@yourlms.com
NEXT_PUBLIC_ORG_CONTACT_PHONE=+1234567890

# ===================================
# FEATURE FLAGS (Public)
# ===================================
NEXT_PUBLIC_FEATURE_CHAT=true
NEXT_PUBLIC_FEATURE_FORUM=true
NEXT_PUBLIC_FEATURE_LIVE_CLASSES=false
NEXT_PUBLIC_FEATURE_CERTIFICATES=true
NEXT_PUBLIC_FEATURE_ASSIGNMENTS=true
NEXT_PUBLIC_FEATURE_QUIZZES=true
NEXT_PUBLIC_FEATURE_GAMIFICATION=false
NEXT_PUBLIC_FEATURE_ANALYTICS=true

# ===================================
# PAYMENT INTEGRATION (Public Keys)
# ===================================
# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
STRIPE_SECRET_KEY=sk_test_your-secret-key
# Note: Secret key is server-side only

# PayPal
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# SSLCommerz
NEXT_PUBLIC_SSLCOMMERZ_ENABLED=false

# ===================================
# GOOGLE SERVICES
# ===================================
# Google Analytics
NEXT_PUBLIC_GA_ID=UA-XXXXXXXXX-X

# Google Maps (for location features)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ===================================
# SOCIAL MEDIA & SHARING
# ===================================
# Facebook App ID (for Facebook SDK, Pixel)
NEXT_PUBLIC_FACEBOOK_APP_ID=your-facebook-app-id

# Facebook Pixel
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=your-facebook-pixel-id

# Twitter/X
NEXT_PUBLIC_TWITTER_HANDLE=@yourlms

# ===================================
# EMAIL CONFIGURATION (Server-side)
# ===================================
# Email service for contact forms, notifications
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@yourlms.com
EMAIL_FROM_NAME=LMS Platform

# ===================================
# FILE STORAGE & CDN
# ===================================
# Cloudinary (for image uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-upload-preset
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# AWS S3 (alternative)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name
NEXT_PUBLIC_AWS_S3_URL=https://your-bucket.s3.amazonaws.com

# CDN URL for static assets
NEXT_PUBLIC_CDN_URL=https://cdn.yourlms.com

# ===================================
# VIDEO STREAMING
# ===================================
# Video streaming service (Vimeo, Wistia, custom)
NEXT_PUBLIC_VIDEO_PROVIDER=cloudinary
# Options: cloudinary, vimeo, wistia, youtube, custom

# Vimeo
VIMEO_ACCESS_TOKEN=your-vimeo-access-token
NEXT_PUBLIC_VIMEO_CLIENT_ID=your-vimeo-client-id

# Wistia
NEXT_PUBLIC_WISTIA_API_KEY=your-wistia-api-key

# ===================================
# SEARCH & AUTOCOMPLETE
# ===================================
# Algolia (for search functionality)
NEXT_PUBLIC_ALGOLIA_APP_ID=your-algolia-app-id
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=your-algolia-search-only-key
ALGOLIA_ADMIN_KEY=your-algolia-admin-key

# ===================================
# CHAT & MESSAGING
# ===================================
# Pusher (for real-time chat)
NEXT_PUBLIC_PUSHER_APP_KEY=your-pusher-app-key
NEXT_PUBLIC_PUSHER_CLUSTER=your-cluster
PUSHER_APP_ID=your-pusher-app-id
PUSHER_SECRET=your-pusher-secret

# Socket.IO (alternative)
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# ===================================
# NOTIFICATION SERVICES
# ===================================
# Firebase Cloud Messaging (for push notifications)
NEXT_PUBLIC_FCM_VAPID_KEY=your-fcm-vapid-public-key
NEXT_PUBLIC_FCM_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FCM_AUTH_DOMAIN=your-app.firebaseapp.com
NEXT_PUBLIC_FCM_PROJECT_ID=your-project-id
NEXT_PUBLIC_FCM_STORAGE_BUCKET=your-app.appspot.com
NEXT_PUBLIC_FCM_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FCM_APP_ID=your-app-id

# ===================================
# ANALYTICS & TRACKING
# ===================================
# Mixpanel
NEXT_PUBLIC_MIXPANEL_TOKEN=your-mixpanel-token

# Hotjar
NEXT_PUBLIC_HOTJAR_ID=your-hotjar-id
NEXT_PUBLIC_HOTJAR_SNIPPET_VERSION=6

# Segment
NEXT_PUBLIC_SEGMENT_WRITE_KEY=your-segment-write-key

# ===================================
# ERROR TRACKING
# ===================================
# Sentry
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project
SENTRY_ENVIRONMENT=development

# ===================================
# RECAPTCHA
# ===================================
# Google reCAPTCHA v3
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# ===================================
# LOCALIZATION & I18N
# ===================================
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SUPPORTED_LOCALES=en,es,fr,de,ar,bn
NEXT_PUBLIC_TIMEZONE=UTC
NEXT_PUBLIC_DATE_FORMAT=YYYY-MM-DD
NEXT_PUBLIC_TIME_FORMAT=HH:mm:ss

# ===================================
# SEO & META
# ===================================
NEXT_PUBLIC_SITE_NAME=LMS Platform
NEXT_PUBLIC_SITE_DESCRIPTION=Comprehensive Learning Management System
NEXT_PUBLIC_SITE_KEYWORDS=lms,learning,education,courses,online learning
NEXT_PUBLIC_SITE_AUTHOR=LMS Team
NEXT_PUBLIC_SITE_TWITTER_HANDLE=@yourlms
NEXT_PUBLIC_SITE_OG_IMAGE=https://yourlms.com/og-image.jpg

# ===================================
# PERFORMANCE & OPTIMIZATION
# ===================================
# Enable/disable image optimization
NEXT_PUBLIC_ENABLE_IMAGE_OPTIMIZATION=true

# Enable/disable analytics in development
NEXT_PUBLIC_ENABLE_DEV_ANALYTICS=false

# Enable PWA (Progressive Web App)
NEXT_PUBLIC_ENABLE_PWA=true

# ===================================
# SECURITY
# ===================================
# Content Security Policy
NEXT_PUBLIC_CSP_ENABLED=true

# Enable HTTPS redirect
NEXT_PUBLIC_FORCE_HTTPS=false

# API Rate Limiting (client-side awareness)
NEXT_PUBLIC_API_RATE_LIMIT=100
NEXT_PUBLIC_API_RATE_WINDOW=900000

# ===================================
# DEVELOPMENT & DEBUGGING
# ===================================
# Enable debug mode
NEXT_PUBLIC_DEBUG=false

# Enable React DevTools in production
NEXT_PUBLIC_ENABLE_REACT_DEVTOOLS=false

# Show error details to users
NEXT_PUBLIC_SHOW_ERROR_DETAILS=false

# Mock API responses
NEXT_PUBLIC_USE_MOCK_API=false

# ===================================
# THIRD-PARTY INTEGRATIONS
# ===================================
# Intercom (for customer support chat)
NEXT_PUBLIC_INTERCOM_APP_ID=your-intercom-app-id

# Zendesk
NEXT_PUBLIC_ZENDESK_KEY=your-zendesk-key

# Crisp Chat
NEXT_PUBLIC_CRISP_WEBSITE_ID=your-crisp-website-id

# Calendly (for scheduling)
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/yourcompany

# ===================================
# MAINTENANCE MODE
# ===================================
NEXT_PUBLIC_MAINTENANCE_MODE=false
NEXT_PUBLIC_MAINTENANCE_MESSAGE=We are currently performing maintenance. We'll be back soon!

# ===================================
# CUSTOM DOMAIN & BRANDING
# ===================================
# Custom domain support
NEXT_PUBLIC_CUSTOM_DOMAIN=www.yourlms.com

# Branding colors
NEXT_PUBLIC_PRIMARY_COLOR=#3B82F6
NEXT_PUBLIC_SECONDARY_COLOR=#10B981
NEXT_PUBLIC_ACCENT_COLOR=#F59E0B

# ===================================
# CONTACT & SUPPORT
# ===================================
NEXT_PUBLIC_SUPPORT_EMAIL=support@yourlms.com
NEXT_PUBLIC_SUPPORT_PHONE=+1-800-LMS-HELP
NEXT_PUBLIC_SUPPORT_URL=https://support.yourlms.com

# ===================================
# LEGAL & COMPLIANCE
# ===================================
NEXT_PUBLIC_PRIVACY_POLICY_URL=https://yourlms.com/privacy
NEXT_PUBLIC_TERMS_OF_SERVICE_URL=https://yourlms.com/terms
NEXT_PUBLIC_COOKIE_POLICY_URL=https://yourlms.com/cookies

# Cookie Consent
NEXT_PUBLIC_ENABLE_COOKIE_CONSENT=true

# GDPR Compliance
NEXT_PUBLIC_GDPR_ENABLED=true

# ===================================
# REVALIDATION & CACHING
# ===================================
# ISR (Incremental Static Regeneration) revalidation time
NEXT_PUBLIC_REVALIDATE_TIME=60

# API response cache time (in seconds)
NEXT_PUBLIC_CACHE_TTL=300

# ===================================
# DEFAULT AVATAR & PLACEHOLDERS
# ===================================
NEXT_PUBLIC_DEFAULT_AVATAR_URL=https://api.dicebear.com/7.x/initials/svg
NEXT_PUBLIC_DEFAULT_COURSE_IMAGE=https://placehold.co/600x400?text=Course
NEXT_PUBLIC_DEFAULT_BANNER_IMAGE=https://placehold.co/1200x400?text=Banner

# ===================================
# PAGINATION & LIMITS
# ===================================
NEXT_PUBLIC_ITEMS_PER_PAGE=12
NEXT_PUBLIC_MAX_UPLOAD_SIZE=10485760
# 10MB in bytes

# ===================================
# WEBSOCKET CONFIGURATION
# ===================================
NEXT_PUBLIC_WS_URL=ws://localhost:5000
NEXT_PUBLIC_WS_RECONNECT_INTERVAL=5000

# ===================================
# BUILD & DEPLOYMENT
# ===================================
# Vercel Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS=false

# Build ID (for cache busting)
NEXT_PUBLIC_BUILD_ID=dev

# Git commit SHA (for version tracking)
NEXT_PUBLIC_COMMIT_SHA=local-dev
